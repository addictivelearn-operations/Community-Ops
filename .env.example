# ---------------------------------------------------------------------------
# community-ops-app — copy to .env and fill in. NEVER commit .env or paste its
# values into chat, a sheet, or a code file.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
# Random string; signs the login cookie. Change it to log everyone out.
APP_SECRET=change-me-to-a-long-random-string
# Where the app is reachable. Localhost for now; the live URL later.
APP_BASE_URL=http://localhost:8000
# "IST" stamps in the sheets, same as Apps Script.
APP_TIMEZONE=Asia/Kolkata

# --- Google sign-in (OAuth client of type "Web application") ---------------
# Google Cloud Console > APIs & Services > Credentials > Create credentials >
# OAuth client ID > Web application. Authorised redirect URI must be exactly
#   {APP_BASE_URL}/auth/callback
# Enable these APIs on the project: Google Sheets API, Google Drive API, Gmail API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only these email domains may sign in (comma-separated).
ALLOWED_DOMAINS=lawsikho.in,addictivelearn.com
# Who may approve/send, and the name written to the "Trigger by" columns.
# Same shape as the Apps Script AUTHORIZED_SENDERS property.
AUTHORIZED_SENDERS={"baisakhi@addictivelearn.com":"Baisakhi","ayushi.s@lawsikho.in":"Ayushi","kawal@lawsikho.in":"Kawal","navark.b@addictivelearn.com":"Navark"}
# The only account that may add a test refund/ticket entry or delete any
# entry (21 Sep 2026) — narrower than AUTHORIZED_SENDERS above, which every
# editor is in. Defaults to kawal@lawsikho.in if unset.
SUPERUSER_EMAIL=kawal@lawsikho.in

# --- Zoho Desk (same Self Client as the token bridge) ----------------------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=60013446135
ZOHO_DC=in

# --- Sheets ----------------------------------------------------------------
TRACKER_SHEET_ID=1zVyWQKDkUIO0Naf97cmb64C4FJgzd1_m5c5TBTSEMO0
MAIN_TAB=From 27th May 26 onward
REFUND_TAB=Community Refund

# --- Ticket replies (main tab) ---------------------------------------------
REPLY_DEFAULT_FROM=noreply@addictivelearn.com
# Optional per-brand override, JSON: {"lawsikho":"support@lawsikho.in"}
REPLY_FROM_ADDRESSES={}
REPLY_CLOSE_STATUS=Closed

# --- Community refunds (Zoho email to the learner) -------------------------
RF_DEPARTMENT_ID=67898000253072456
RF_FROM_ADDRESS=noreply@addictivelearn.com

# --- Team handoff (finance) ------------------------------------------------
RF_TEAM_SHEET_ID=14CjWJ0Q5N57Dwxtg8IraK54jeppYbxTRfugDz5K2esA
RF_TEAM_TAB=Community Refunds Tracker
RF_TEAM_DOC_FOLDER_ID=1CMC8YphXc6wd2w5CPgmVNNDS3sLur8lo
RF_TEAM_FIRST_AUTO_ROW=51
RF_TEAM_TO=pooja.s@lawsikho.in,garimagera@lawsikho.in,abha@ipleaders.in
RF_TEAM_CC=abhyuday@lawsikho.in,ramanuj@lawsikho.in,sanghita@lawsikho.in,yash@lawsikho.in,shruti@lawsikho.in,siddhant@lawsikho.in,ayushi.s@lawsikho.in,baisakhi@addictivelearn.com,mohammad.aquib@lawsikho.in
RF_TEAM_BCC=internal_comm@lawsikho1.zohodesk.in
RF_TEAM_SIGNATURE=Community Team
RF_TEAM_DEADLINE_DAYS=15

# --- Read-only export (Master Refund Tracker's "Community Refunds" tab) ------
# A long random string. The tracker sends it as X-Api-Key to GET /api/refunds.json.
# Leave empty to switch the endpoint off.
EXPORT_API_KEY=

# --- The Master Refund Tracker app (finance hand-off destination) ---------
# When both are set, Trigger = Yes sends the finance row to the tracker's
# Phase 4 → "Community Refund" tab instead of the Community Refunds Tracker
# sheet (the Zoho email, the Doc and the finance email are unchanged).
# TRACKER_API_KEY is the tracker's COMMUNITY_OPS_API_KEY — the same value.
TRACKER_URL=https://master-refund-tracker-production.up.railway.app
TRACKER_API_KEY=
